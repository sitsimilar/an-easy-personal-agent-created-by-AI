# 复制本文件为 web/.env 并填入你自己的云服务信息。
# 这三个值来自你的 WorkBuddy 云服务应用（可在「设置—数据管理—应用」查看）。

# 云服务 endpoint（你的云应用发布域名）
VITE_CLOUD_ENDPOINT=https://your-app.workbuddy.host

# OAuth 中转（微信扫码登录用），WorkBuddy 公共平台地址，一般无需改动
VITE_OAUTH_RELAY_BASE_URL=https://www.workbuddy.cn/v2/as/genie-baas/oauth

# 云服务 publishable key（客户端公开 key，非服务端密钥）
VITE_CLOUD_PUBLISHABLE_KEY=wbpk_replace_me
